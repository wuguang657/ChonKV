    {
      "id": "e001018",
      "type": "text",
      "x": 352,
      "y": 478,
      "width": 226.392578125,
      "height": 17.5,
      "text": "AppendEntries (追加日志/心跳 RPC)",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "AppendEntries (追加日志/心跳 RPC)",
      "lineHeight": 1.25,
