    {
      "id": "e001024",
      "type": "text",
      "x": 692,
      "y": 118,
      "width": 159.46875,
      "height": 17.5,
      "text": "CheckQuorum (存活自查)",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "CheckQuorum (存活自查)",
      "lineHeight": 1.25,
      "baseline": 14,
