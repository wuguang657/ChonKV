    {
      "id": "sT_title1",
      "type": "text",
      "x": 1050.4211399320998,
      "y": 819.9033363301785,
      "width": 276,
      "height": 18,
      "text": "SessionTable（会话去重表）",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "SessionTable（会话去重表）",
      "lineHeight": 1.25,
      "baseline": 14,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "seed": 111003,
      "version": 218,
      "versionNonce": 269888269,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1791701666214,
      "link": null,
      "locked": false,
