      "type": "text",
      "x": 692,
      "y": 308,
      "width": 266,
      "height": 18.2,
      "text": "ReadIndex (线性一致读点)",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "ReadIndex (线性一致读点)",
      "lineHeight": 1.25,
