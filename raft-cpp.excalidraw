    {
      "id": "mbr02",
      "type": "text",
      "x": 691.5780035166374,
      "y": 966.7475521037325,
      "width": 181.2138671875,
      "height": 35,
      "text": "ProposeConfChangeTo \n(配置变更提案,由客户端调用)",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "ProposeConfChangeTo \n(配置变更提案,由客户端调用)",
      "lineHeight": 1.25,
      "baseline": 14,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "seed": 875169989,
      "version": 109,
      "versionNonce": 1915142664,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1791369013157,
      "link": null,
      "locked": false,
      "index": "bg4",
      "roundness": null,
      "created": null,
