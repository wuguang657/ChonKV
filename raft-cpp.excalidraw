    {
      "id": "e001021",
      "type": "text",
      "x": 352,
      "y": 728,
      "width": 266,
      "height": 18.2,
      "text": "InstallSnapshot (分块快照 RPC)",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "InstallSnapshot (分块快照 RPC)",
      "lineHeight": 1.25,
      "baseline": 14,
      "angle": 0,
      "strokeColor": "#6741d9",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "seed": 19361590,
      "version": 10,
      "versionNonce": 1033482234,
      "isDeleted": false,
      "boundElements": [],
