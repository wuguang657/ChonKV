    {
      "id": "e001027",
      "type": "text",
      "x": 692,
      "y": 308,
      "width": 266,
      "height": 18.2,
      "text": "ReadIndex (线性一致读点)",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "ReadIndex (线性一致读点)",
      "lineHeight": 1.25,
      "baseline": 14,
      "angle": 0,
      "strokeColor": "#2f9e44",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "seed": 25215623,
      "version": 9,
      "versionNonce": 2065447482,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1792139831827,
      "link": null,
      "locked": false,
      "index": "bhAD",
      "roundness": null,
      "created": null,
