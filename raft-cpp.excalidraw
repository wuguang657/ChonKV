    {
      "id": "e001018",
      "type": "text",
      "x": 352,
      "y": 478,
      "width": 226.392578125,
      "height": 17.5,
      "text": "AppendEntries (追加日志/心跳 RPC)",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "AppendEntries (追加日志/心跳 RPC)",
      "lineHeight": 1.25,
      "baseline": 14,
      "angle": 0,
      "strokeColor": "#6741d9",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "seed": 29673101,
      "version": 26,
      "versionNonce": 767924013,
      "isDeleted": false,
      "boundElements": [
        {
          "id": "e001058",
          "type": "arrow"
        }
      ],
      "updated": 1791700997002,
      "link": null,
      "locked": false,
      "index": "bgX9",
      "roundness": null,
