    {
      "id": "e001021",
      "type": "text",
      "x": 352,
      "y": 728,
      "width": 266,
      "height": 18.2,
      "text": "InstallSnapshot (快照 RPC)",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "InstallSnapshot (快照 RPC)",
      "lineHeight": 1.25,
      "baseline": 14,
      "angle": 0,
      "strokeColor": "#6741d9",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
